{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/intune-win32-packaging.html",
      "destination": "/Blogs/intune-win32-packaging.html"
    },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "skills.akashnagapure.in" }], "destination": "/Sub_Pages/Skills.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "food.akashnagapure.in" }], "destination": "/Sub_Pages/Food.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "blogs.akashnagapure.in" }], "destination": "/Sub_Pages/Projects.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "resume.akashnagapure.in" }], "destination": "/Sub_Pages/resume.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "courses.akashnagapure.in" }], "destination": "/Sub_Pages/courses.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "homelab.akashnagapure.in" }], "destination": "/Sub_Pages/HomeLab.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "reading.akashnagapure.in" }], "destination": "/Sub_Pages/Reading.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "gaming.akashnagapure.in" }], "destination": "/Sub_Pages/Game.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "coins.akashnagapure.in" }], "destination": "/Sub_Pages/Coins.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "puzzle.akashnagapure.in" }], "destination": "/Sub_Pages/Puzzle.html" }
  ]
}
