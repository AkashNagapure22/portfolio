{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "skills.akashnagapure.in" }], "destination": "/Skills.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "food.akashnagapure.in" }], "destination": "/Food.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "blogs.akashnagapure.in" }], "destination": "/Projects.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "resume.akashnagapure.in" }], "destination": "/resume.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "courses.akashnagapure.in" }], "destination": "/courses.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "homelab.akashnagapure.in" }], "destination": "/HomeLab.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "reading.akashnagapure.in" }], "destination": "/Reading.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "gaming.akashnagapure.in" }], "destination": "/Game.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "coins.akashnagapure.in" }], "destination": "/Coins.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "puzzle.akashnagapure.in" }], "destination": "/Puzzle.html" }
  ]
}
